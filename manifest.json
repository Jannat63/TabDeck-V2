{
  "manifest_version": 3,
  "name": "TabDeck",
  "version": "2.2.0",
  "minimum_chrome_version": "104",
  "description": "A beautiful, private new tab page: workspaces, bookmarks, notes, tasks and a focus timer. By Shihab Hossain & Ahsan Jannat.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page to TabDeck",
    "default_icon": {
      "16":  "assets/favicon.png",
      "48":  "assets/favicon.png",
      "128": "assets/favicon.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16":  "assets/favicon.png",
    "48":  "assets/favicon.png",
    "128": "assets/favicon.png"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "history",
    "downloads",
    "topSites",
    "favicon",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "optional_permissions": [
    "geolocation"
  ],
  "host_permissions": [
    "https://wttr.in/*"
  ]
}
